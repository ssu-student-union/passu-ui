{
  "name": "@passu/ui",
  "private": true,
  "version": "0.1.1",
  "description": "PASSU admin·user 앱이 공유하는 UI 컴포넌트 라이브러리",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssu-student-union/passu-ui.git"
  },
  "homepage": "https://github.com/ssu-student-union/passu-ui#readme",
  "bugs": {
    "url": "https://github.com/ssu-student-union/passu-ui/issues"
  },
  "type": "module",
  "main": "./dist/passu-ui.js",
  "module": "./dist/passu-ui.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "styles"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/passu-ui.js"
    },
    "./style.css": "./dist/passu-ui.css",
    "./theme.css": "./styles/theme.css"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "prepare": "lefthook install",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepack": "pnpm run build",
    "release": "changeset tag"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "clsx": "^2.1.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-svgr": "^5.2.0"
  },
  "sideEffects": ["*.css"]
}
